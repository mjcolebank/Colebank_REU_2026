SHORT_NAME = {"Early-fusion Bayesian": "Early-B", "Late-fusion Bayesian": "Late-B",
              "Early-fusion CNN": "Early-CNN", "Late-fusion CNN": "Late-CNN"}


def _fmt_pct(x, d=1):
    return "-" if pd.isna(x) else f"{100 * x:.{d}f}"


def _marginal(df):
    return df[df["group_type"].isin(MARGINAL_TYPES)]


def format_model_table(df):
    """Human-readable marginal table for one model (adds inconclusive columns if available)."""
    show_incon = "n_inconclusive" in df.columns and df["n_inconclusive"].notna().any()
    rows = []
    for _, r in _marginal(df).iterrows():
        small = "*" if 0 < r["n"] < 30 else ""
        if r["n"] == 0:
            acc = "-"
        else:
            acc = f"{_fmt_pct(r['accuracy'])} [{_fmt_pct(r['acc_ci_lo'])}, {_fmt_pct(r['acc_ci_hi'])}]"
        row = {
            "Type": r["group_type"], "Group": r["group"] + small, "n": int(r["n"]),
            "% of split": _fmt_pct(r["pct_of_split"] / 100),
            "SHD prev %": _fmt_pct(r.get("shd_prevalence")),
            "Accuracy % [95% CI]": acc,
            "Sens %": _fmt_pct(r.get("sensitivity")), "Spec %": _fmt_pct(r.get("specificity")),
            "AUROC": "-" if pd.isna(r.get("auroc")) else f"{r['auroc']:.3f}",
        }
        if show_incon:
            row["Inconclusive n (%)"] = ("-" if r["n"] == 0 else
                                         f"{int(r['n_inconclusive'])} ({_fmt_pct(r['pct_inconclusive'])})")
            row["Acc | conclusive %"] = _fmt_pct(r.get("acc_conclusive"))
            row["Acc | inconclusive %"] = _fmt_pct(r.get("acc_inconclusive"))
        rows.append(row)
    return pd.DataFrame(rows)


def df_to_markdown(df):
    cols = list(df.columns)
    lines = ["| " + " | ".join(cols) + " |", "|" + "|".join("---" for _ in cols) + "|"]
    for _, r in df.iterrows():
        lines.append("| " + " | ".join(str(r[c]) for c in cols) + " |")
    return "\n".join(lines)


def build_wide_accuracy_table(long_df, model_names):
    marg = _marginal(long_df)
    first = marg[marg["model"] == model_names[0]]
    rows = []
    for _, g in first.iterrows():
        row = {"Type": g["group_type"], "Group": g["group"], "n": int(g["n"]),
               "% of split": _fmt_pct(g["pct_of_split"] / 100),
               "Ref % (full 100K)": "-" if pd.isna(g["ref_pct"]) else f"{g['ref_pct']:.2f}"}
        for m in model_names:
            r = marg[(marg["model"] == m) & (marg["group_type"] == g["group_type"])
                     & (marg["group"] == g["group"])].iloc[0]
            row[SHORT_NAME.get(m, m)] = "-" if r["n"] == 0 else _fmt_pct(r["accuracy"])
        rows.append(row)
    return pd.DataFrame(rows)


def build_inconclusive_summary(long_df, joint_df, bayes_names):
    """Conclusive vs inconclusive breakdown for the marginal groups (Bayesian models only)."""
    marg = _marginal(long_df)
    first = marg[marg["model"] == bayes_names[0]]
    rows = []
    for _, g in first.iterrows():
        row = {"Type": g["group_type"], "Group": g["group"], "n": int(g["n"])}
        for m in bayes_names:
            r = marg[(marg["model"] == m) & (marg["group_type"] == g["group_type"])
                     & (marg["group"] == g["group"])].iloc[0]
            t = SHORT_NAME.get(m, m)
            if r["n"] == 0:
                row[f"{t} incon. n (%)"] = row[f"{t} acc|concl %"] = row[f"{t} acc|incon %"] = "-"
            else:
                row[f"{t} incon. n (%)"] = f"{int(r['n_inconclusive'])} ({_fmt_pct(r['pct_inconclusive'])})"
                row[f"{t} acc|concl %"] = _fmt_pct(r["acc_conclusive"])
                row[f"{t} acc|incon %"] = _fmt_pct(r["acc_inconclusive"])
        if joint_df is not None:
            j = joint_df[(joint_df["group_type"] == g["group_type"]) & (joint_df["group"] == g["group"])].iloc[0]
            row["Both incon. n (%)"] = "-" if j["n"] == 0 else f"{int(j['n_both'])} ({_fmt_pct(j['pct_both'])})"
        rows.append(row)
    return pd.DataFrame(rows)


def make_matrix(rows, value_col, n_col, age_levels, race_levels, min_cell, kind="pct"):
    """Age (rows) x race (columns) matrix with an 'All' margin on each axis.

    Cells whose supporting sample (n_col) is below `min_cell` are starred; empty cells show '-'.
    """
    lookup = {(r["age_group"], r["race_group"]): r for _, r in rows.iterrows()}
    ages, races = list(age_levels) + ["All"], list(race_levels) + ["All"]
    out = []
    for a in ages:
        row = {"Age": a}
        for c in races:
            r = lookup.get((a, c))
            if r is None or pd.isna(r.get(n_col)) or r[n_col] == 0 or pd.isna(r.get(value_col)):
                row[c] = "-"
            elif kind == "int":
                row[c] = str(int(r[value_col]))
            else:
                row[c] = f"{100 * r[value_col]:.1f}" + ("*" if r[n_col] < min_cell else "")
        out.append(row)
    return pd.DataFrame(out)


