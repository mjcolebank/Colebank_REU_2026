def summarize_draws(draws, threshold, minority_frac_min):
    """Same definition as find_inconclusive_patients.py::summarize.

    A patient is INCONCLUSIVE when (a) the central 95% interval of the posterior draws contains
    the decision threshold AND (b) at least `minority_frac_min` of the draws fall on the opposite
    side of the threshold from the majority. Everything else is CONCLUSIVE.
    """
    mean = draws.mean(0, dtype=np.float64)
    lo, hi = np.quantile(draws, [0.025, 0.975], axis=0)
    frac_pos = (draws >= threshold).mean(0)
    minority = np.minimum(frac_pos, 1.0 - frac_pos)
    straddle = (lo < threshold) & (hi > threshold)
    return {"prob": mean, "lower_95": lo, "upper_95": hi, "minority_frac": minority,
            "inconclusive": straddle & (minority >= minority_frac_min)}


def wilson_ci(k, n, z=1.96):
    if n == 0:
        return np.nan, np.nan
    p = k / n
    denom = 1 + z ** 2 / n
    centre = (p + z ** 2 / (2 * n)) / denom
    half = z * np.sqrt(p * (1 - p) / n + z ** 2 / (4 * n ** 2)) / denom
    return centre - half, centre + half


def group_metrics(probs, labels, mask, threshold=0.5, incon=None):
    p, y = probs[mask], labels[mask]
    n = int(mask.sum())
    if n == 0:
        return {"n": 0}
    pred = (p >= threshold).astype(int)
    right = pred == y
    tp = int(((pred == 1) & (y == 1)).sum()); tn = int(((pred == 0) & (y == 0)).sum())
    fp = int(((pred == 1) & (y == 0)).sum()); fn = int(((pred == 0) & (y == 1)).sum())
    lo, hi = wilson_ci(tp + tn, n)
    out = {
        "n": n,
        "n_shd": int(y.sum()),
        "shd_prevalence": y.mean(),
        "accuracy": (tp + tn) / n,
        "acc_ci_lo": lo, "acc_ci_hi": hi,
        "sensitivity": tp / (tp + fn) if (tp + fn) else np.nan,
        "specificity": tn / (tn + fp) if (tn + fp) else np.nan,
        "auroc": roc_auc_score(y, p) if len(np.unique(y)) == 2 else np.nan,
    }
    if incon is not None:  # Bayesian models only
        inc = incon[mask]
        n_inc = int(inc.sum())
        ilo, ihi = wilson_ci(n_inc, n)
        out.update({
            "n_inconclusive": n_inc, "n_conclusive": n - n_inc,
            "pct_inconclusive": n_inc / n, "incon_ci_lo": ilo, "incon_ci_hi": ihi,
            "acc_conclusive": right[~inc].mean() if (~inc).any() else np.nan,
            "acc_inconclusive": right[inc].mean() if inc.any() else np.nan,
        })
    return out


def joint_inconclusive_metrics(incon_early, incon_late, mask):
    n = int(mask.sum())
    if n == 0:
        return {"n": 0}
    e, l = incon_early[mask], incon_late[mask]
    return {"n": n, "n_incon_early": int(e.sum()), "n_incon_late": int(l.sum()),
            "n_both": int((e & l).sum()), "pct_incon_early": e.mean(), "pct_incon_late": l.mean(),
            "pct_both": (e & l).mean()}


MARGINAL_TYPES = ("Overall", "Age", "Race/Ethnicity")


def build_groups(meta, intersections=True):
    """Marginal groups (overall / age / race) and age x race intersection cells."""
    age = pd.to_numeric(meta["age_at_ecg"], errors="coerce")
    age_grp = pd.cut(age, AGE_BINS, labels=AGE_LABELS, right=False).astype(object)
    race = meta["race_ethnicity"].astype("string").str.strip().str.capitalize()
    ones = np.ones(len(meta), dtype=bool)

    # "<18" is not in the reference table; it is shown only if such ECGs exist.
    age_levels = [l for l in AGE_LABELS if l != "<18" or (age_grp == l).any()]
    age_masks = {l: (age_grp == l).to_numpy(dtype=bool) for l in age_levels}
    race_levels = list(RACE_ORDER) + sorted(set(race.dropna().unique()) - set(RACE_ORDER))
    race_masks = {l: (race == l).fillna(False).to_numpy(dtype=bool) for l in race_levels}

    def G(gtype, name, mask, ref, a, r):
        return {"group_type": gtype, "group": name, "mask": mask, "ref_pct": ref,
                "age_group": a, "race_group": r}

    groups = [G("Overall", "All", ones, 100.0, "All", "All")]
    for l in age_levels:
        groups.append(G("Age", l, age_masks[l], REF_AGE_PCT.get(l, np.nan), l, "All"))
    if age.isna().any():
        groups.append(G("Age", "Missing", age.isna().to_numpy(), np.nan, "Missing", "All"))
    for l in race_levels:
        groups.append(G("Race/Ethnicity", l, race_masks[l], REF_RACE_PCT.get(l, np.nan), "All", l))
    if race.isna().any():
        groups.append(G("Race/Ethnicity", "Missing", race.isna().to_numpy(), np.nan, "All", "Missing"))
    if intersections:
        for a in age_levels:
            for r in race_levels:
                groups.append(G("Age x Race/Ethnicity", f"{a} | {r}", age_masks[a] & race_masks[r],
                                np.nan, a, r))
    return groups, age_levels, race_levels


