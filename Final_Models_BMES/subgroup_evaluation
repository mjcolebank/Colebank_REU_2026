# 1. DATA: WAVEFORMS + DEMOGRAPHICS (identical processing to training)
# ──────────────────────────────────────────────────────────────────────
def load_filtered_waveforms(path, chunk=512):
    """(N,1,2500,12) .npy -> band-pass filtered float32 array of shape (N,12,2500)."""
    raw = np.load(path, mmap_mode="r")
    n, _, t, leads = raw.shape
    nyq = 0.5 * ECG_SAMPLING_RATE_HZ
    b, a = butter(FILTER_ORDER, [FILTER_LOW_HZ / nyq, FILTER_HIGH_HZ / nyq], btype="band")
    out = np.empty((n, leads, t), dtype=np.float32)
    for s in range(0, n, chunk):
        block = np.asarray(raw[s:s + chunk, 0])             # (n,2500,12)
        filt = filtfilt(b, a, block, axis=1)                 # filter along time, per lead
        out[s:s + chunk] = np.swapaxes(filt, 1, 2).astype(np.float32)
    return out


def _imputer_input(df, categories):
    codes = pd.DataFrame(index=df.index)
    for col in CATEGORICAL_COLS:
        codes[col] = pd.Categorical(df[col], categories=categories[col]).codes
    codes = codes.where(codes >= 0)  # unseen / missing category -> NaN (to be imputed)
    return pd.concat([codes, df[CONTINUOUS_COLS].astype(float)], axis=1)


def _impute_and_encode(df, categories, imputer, feature_names=None):
    df = df[ALL_DEMO_COLS]
    imputed = pd.DataFrame(imputer.transform(_imputer_input(df, categories)),
                           columns=ALL_DEMO_COLS, index=df.index)
    for col in CATEGORICAL_COLS:
        cats = categories[col]
        codes = imputed[col].round().astype(int).clip(0, len(cats) - 1)
        imputed[col] = pd.Categorical.from_codes(codes, categories=cats)
    ohe = pd.get_dummies(imputed, columns=CATEGORICAL_COLS, dtype=float)
    if feature_names is not None:
        ohe = ohe.reindex(columns=feature_names, fill_value=0)
    return ohe


def fit_demographic_preprocessor(train_df, knn_k):
    """Re-create the training-time imputer/scaler from the TRAIN split metadata."""
    df = train_df[ALL_DEMO_COLS]
    categories = {c: df[c].astype("category").cat.categories for c in CATEGORICAL_COLS}
    imputer = KNNImputer(n_neighbors=knn_k).fit(_imputer_input(df, categories))
    ohe = _impute_and_encode(df, categories, imputer)
    feature_names = list(ohe.columns)
    scaler = StandardScaler().fit(ohe[CONTINUOUS_COLS].to_numpy(dtype=np.float32))
    return {"scaler": scaler, "imputer": imputer, "categories": categories,
            "feature_names": feature_names}


def transform_demographics(df, prep):
    ohe = _impute_and_encode(df, prep["categories"], prep["imputer"], prep["feature_names"])
    arr = ohe.to_numpy(dtype=np.float32)
    idx = [prep["feature_names"].index(c) for c in CONTINUOUS_COLS]
    arr[:, idx] = prep["scaler"].transform(arr[:, idx])
    return arr


def extract_prep_from_checkpoint(ckpt):
    keys = ("demographic_scaler", "demographic_imputer", "demographic_categories", "feature_names")
    if isinstance(ckpt, dict) and all(k in ckpt for k in keys):
        return {"scaler": ckpt["demographic_scaler"], "imputer": ckpt["demographic_imputer"],
                "categories": ckpt["demographic_categories"], "feature_names": ckpt["feature_names"]}
    return None


