def find_metadata(data_dir):
    for f in glob.glob(os.path.join(data_dir, "*")):
        if os.path.basename(f).lower() == "echonext_metadata_100k.csv":
            return f
    raise FileNotFoundError(f"echonext_metadata_100k.csv not found in {data_dir}")


def parse_args():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--data-dir", default="../EchoNextData")
    p.add_argument("--split", default="test", choices=["test", "val", "train"])
    p.add_argument("--label", default="shd_moderate_or_greater_flag")
    p.add_argument("--early-bayes"); p.add_argument("--late-bayes")
    p.add_argument("--early-cnn"); p.add_argument("--late-cnn")
    p.add_argument("--out-dir", default="subgroup_results")
    p.add_argument("--mc-samples", type=int, default=200,
                   help="posterior draws per ECG for Bayesian models (200 = find_inconclusive default)")
    p.add_argument("--threshold", type=float, default=0.5,
                   help="decision threshold for accuracy AND for the inconclusive straddle test")
    p.add_argument("--minority-frac", type=float, default=0.20,
                   help="inconclusive if >= this share of posterior draws fall on the opposite side "
                        "of the threshold (and the 95%% interval straddles it)")
    p.add_argument("--min-cell", type=int, default=30, help="cells with fewer ECGs are starred")
    p.add_argument("--no-intersections", action="store_true", help="skip age x race cells")
    p.add_argument("--batch-size", type=int, default=256)
    p.add_argument("--late-cnn-knn-k", type=int, default=3, help="KNN k used when training the late-fusion CNN")
    p.add_argument("--early-cnn-knn-k", type=int, default=5, help="KNN k used when training the early-fusion CNN")
    p.add_argument("--device", default="cuda" if torch.cuda.is_available() else "cpu")
    p.add_argument("--recompute", action="store_true", help="ignore cached per-ECG predictions")
    p.add_argument("--seed", type=int, default=42)
    return p.parse_args()


def main():
    args = parse_args()
    torch.manual_seed(args.seed); np.random.seed(args.seed); pyro.set_rng_seed(args.seed)
    device = torch.device(args.device)
    os.makedirs(args.out_dir, exist_ok=True)
    print(f"Device: {device}", flush=True)

    requested = [k for k in MODEL_REGISTRY if getattr(args, MODEL_REGISTRY[k][0])]
    if not requested:
        sys.exit("Provide at least one of --early-bayes / --late-bayes / --early-cnn / --late-cnn")

    # ---- metadata + split ----
    meta = pd.read_csv(find_metadata(args.data_dir))
    split_meta = meta[meta["split"] == args.split]
    train_meta = meta[meta["split"] == "train"]
    labels = split_meta[args.label].to_numpy().astype(int)
    n_total = len(split_meta)
    print(f"{args.split} split: {n_total} ECGs, {labels.mean():.1%} positive for {args.label}", flush=True)

    # ---- waveforms (filtered once, shared by all models) ----
    wf_path = os.path.join(args.data_dir, f"EchoNext_{args.split}_waveforms.npy")
    t0 = time.time()
    X = load_filtered_waveforms(wf_path)
    print(f"Filtered waveforms {X.shape} in {time.time() - t0:.0f}s", flush=True)
    if len(X) != n_total:
        sys.exit(f"Row mismatch: {len(X)} waveforms vs {n_total} metadata rows for split '{args.split}'")

    groups, age_levels, race_levels = build_groups(split_meta.reset_index(drop=True),
                                                   intersections=not args.no_intersections)

    long_rows, display_names, bayes_names = [], [], []
    incon_flags = {}
    for key in requested:
        flag, display, kind, default_k = MODEL_REGISTRY[key]
        path = getattr(args, flag)
        is_bayes = kind in ("early_bayes", "late_bayes")
        print(f"\n=== {display} ({path}) ===", flush=True)
        cache = os.path.join(args.out_dir, f"preds_{key}_{args.split}.npz")

        draws = prob = None
        if os.path.exists(cache) and not args.recompute:
            z = np.load(cache)
            if is_bayes and "draws" in z.files and z["draws"].shape == (args.mc_samples, n_total):
                draws = z["draws"]
            elif not is_bayes and "prob" in z.files and len(z["prob"]) == n_total:
                prob = z["prob"]
            print(f"    loaded cached predictions from {cache}" if (draws is not None or prob is not None)
                  else "    cache does not match this run (shape / mc-samples) -> recomputing")

        if draws is None and prob is None:
            if is_bayes:
                ckpt_peek = _torch_load(path, "cpu")
                prep, demo_dim = extract_prep_from_checkpoint(ckpt_peek), int(ckpt_peek["demo_dim"])
                del ckpt_peek
                demo = build_demo_array(demo_dim, prep, 5, split_meta, train_meta, args.data_dir, args.split)
                ex_ts = torch.from_numpy(X[:1]).to(device)
                ex_demo = torch.from_numpy(demo[:1]).to(device)
                model, guide, _ = load_pyro_model(path, kind, device, ex_ts, ex_demo)
                draws = predict_bayesian(model, guide, X, demo, args.mc_samples, args.batch_size, device)
                del model, guide
                pyro.clear_param_store()
                np.savez_compressed(cache, draws=draws)
            else:
                model, prep, demo_dim = load_deterministic_model(path, kind, device)
                k = args.late_cnn_knn_k if kind == "late_cnn" else args.early_cnn_knn_k
                demo = build_demo_array(demo_dim, prep, k, split_meta, train_meta, args.data_dir, args.split)
                prob = predict_deterministic(model, X, demo, args.batch_size, device)
                del model
                np.savez_compressed(cache, prob=prob)

        if is_bayes:
            summ = summarize_draws(draws, args.threshold, args.minority_frac)
            probs, incon = summ["prob"], summ["inconclusive"]
            incon_flags[key] = incon
            bayes_names.append(display)
            per_ecg = pd.DataFrame({
                "metadata_index": split_meta.index, "true_label": labels,
                "age_at_ecg": split_meta["age_at_ecg"].to_numpy(),
                "race_ethnicity": split_meta["race_ethnicity"].to_numpy(),
                "posterior_mean": summ["prob"], "lower_95": summ["lower_95"], "upper_95": summ["upper_95"],
                "minority_frac": summ["minority_frac"], "inconclusive": incon,
                "predicted_label": (probs >= args.threshold).astype(int),
            })
            per_ecg.to_csv(os.path.join(args.out_dir, f"per_ecg_posterior_{key}_{args.split}.csv"), index=False)
        else:
            probs, incon = np.asarray(prob, dtype=np.float64), None

        acc = float(((probs >= args.threshold).astype(int) == labels).mean())
        msg = f"    overall accuracy = {acc:.4f}"
        if incon is not None:
            msg += f" | inconclusive = {incon.mean():.1%}"
        print(msg, flush=True)
        display_names.append(display)

        for g in groups:
            mask = g["mask"]
            row = {"model": display, "group_type": g["group_type"], "group": g["group"],
                   "age_group": g["age_group"], "race_group": g["race_group"], "ref_pct": g["ref_pct"],
                   "pct_of_split": 100 * mask.sum() / n_total}
            row.update(group_metrics(probs, labels, mask, args.threshold, incon))
            long_rows.append(row)

    long_df = pd.DataFrame(long_rows)
    long_df.to_csv(os.path.join(args.out_dir, f"subgroup_results_long_{args.split}.csv"), index=False)

    # ---- joint inconclusive (both Bayesian models) ----
    joint_df = None
    if "early_bayes" in incon_flags and "late_bayes" in incon_flags:
        jrows = []
        for g in groups:
            row = {k: g[k] for k in ("group_type", "group", "age_group", "race_group")}
            row.update(joint_inconclusive_metrics(incon_flags["early_bayes"], incon_flags["late_bayes"], g["mask"]))
            jrows.append(row)
        joint_df = pd.DataFrame(jrows)
        joint_df.to_csv(os.path.join(args.out_dir, f"subgroup_joint_inconclusive_{args.split}.csv"), index=False)

    # ---- report ----
    md = [f"# Subgroup performance on the `{args.split}` split\n",
          f"Label: `{args.label}`; decision threshold {args.threshold}; n = {n_total}. "
          "Accuracy CIs are 95% Wilson intervals. Age 90 is a capped value, so `90+` means ages >= 90. "
          "`*` = fewer than the minimum cell size of ECGs (interpret with caution).\n",
          "**Bayesian models**: posterior-mean probability from "
          f"{args.mc_samples} weight draws per ECG. An ECG is *inconclusive* when the 95% interval of its "
          f"draws contains {args.threshold} AND at least {args.minority_frac:.0%} of the draws fall on the "
          "opposite side of the threshold from the majority (same rule as `find_inconclusive_patients.py`); "
          "otherwise it is *conclusive*. The deterministic CNNs produce a single probability, so "
          "inconclusive/conclusive is not defined for them.\n"]

    wide = build_wide_accuracy_table(long_df, display_names)
    wide.to_csv(os.path.join(args.out_dir, f"subgroup_accuracy_wide_{args.split}.csv"), index=False)
    print("\n" + "=" * 100 + "\nACCURACY (%) BY SUBGROUP AND MODEL\n" + "=" * 100)
    print(wide.to_string(index=False))
    md += ["## Accuracy (%) by subgroup and model\n", df_to_markdown(wide), ""]

    if bayes_names:
        summ_tbl = build_inconclusive_summary(long_df, joint_df, bayes_names)
        summ_tbl.to_csv(os.path.join(args.out_dir, f"subgroup_inconclusive_summary_{args.split}.csv"), index=False)
        print("\n" + "=" * 100 + "\nINCONCLUSIVE vs CONCLUSIVE BY SUBGROUP (Bayesian models)\n" + "=" * 100)
        print(summ_tbl.to_string(index=False))
        md += ["## Inconclusive vs conclusive cases by subgroup (Bayesian models)\n",
               "`acc|concl` / `acc|incon` = accuracy among conclusive / inconclusive ECGs of the group. "
               "`Both incon.` = inconclusive under both Bayesian models.\n",
               df_to_markdown(summ_tbl), ""]

    for name in display_names:
        tbl = format_model_table(long_df[long_df["model"] == name])
        print(f"\n--- {name} ---")
        print(tbl.to_string(index=False))
        md += [f"## {name}\n", df_to_markdown(tbl), ""]

    if not args.no_intersections:
        n_mat = make_matrix(long_df[long_df["model"] == display_names[0]], "n", "n",
                            age_levels, race_levels, args.min_cell, kind="int")
        print("\n" + "=" * 100 + f"\nAGE x RACE/ETHNICITY INTERSECTIONS (rows: age, columns: race; * = n < {args.min_cell})\n"
              + "=" * 100)
        print("\nECGs per cell"); print(n_mat.to_string(index=False))
        md += ["## Age x race/ethnicity intersections\n", f"Starred cells have fewer than {args.min_cell} ECGs "
               "(for the conclusive/inconclusive accuracy matrices the star refers to the size of that "
               "subset). Margins (`All`) are the marginal groups above.\n",
               "### ECGs per cell\n", df_to_markdown(n_mat), ""]
        for name in display_names:
            rows = long_df[long_df["model"] == name]
            is_b = name in bayes_names
            specs = [("Accuracy (%)", "accuracy", "n", True)]
            if is_b:
                specs += [("Inconclusive (% of ECGs)", "pct_inconclusive", "n", True),
                          ("Accuracy among conclusive ECGs (%)", "acc_conclusive", "n_conclusive", False),
                          ("Accuracy among inconclusive ECGs (%)", "acc_inconclusive", "n_inconclusive", False)]
            for title, vcol, ncol, to_console in specs:
                mat = make_matrix(rows, vcol, ncol, age_levels, race_levels, args.min_cell)
                mat.to_csv(os.path.join(args.out_dir, f"matrix_{SHORT_NAME.get(name, name)}_{vcol}_{args.split}.csv"),
                           index=False)
                if to_console:
                    print(f"\n{name}: {title}"); print(mat.to_string(index=False))
                md += [f"### {name}: {title}\n", df_to_markdown(mat), ""]
        if joint_df is not None:
            mat = make_matrix(joint_df, "pct_both", "n", age_levels, race_levels, args.min_cell)
            mat.to_csv(os.path.join(args.out_dir, f"matrix_both_inconclusive_{args.split}.csv"), index=False)
            print("\nInconclusive under BOTH Bayesian models (% of ECGs)"); print(mat.to_string(index=False))
            md += ["### Inconclusive under BOTH Bayesian models (% of ECGs)\n", df_to_markdown(mat), ""]

    with open(os.path.join(args.out_dir, f"subgroup_report_{args.split}.md"), "w") as f:
        f.write("\n".join(md))
    print(f"\nSaved CSVs, cached predictions and Markdown report to: {args.out_dir}")


if __name__ == "__main__":
    main()
