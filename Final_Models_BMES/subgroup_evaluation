# 2. DETERMINISTIC ARCHITECTURES (copied from the training scripts)
# ──────────────────────────────────────────────────────────────────────
class DemographicMLP(nn.Module):
    def __init__(self, input_dim, output_dim=16):
        super().__init__()
        self.mlp = nn.Sequential(
            nn.Linear(input_dim, 32), nn.BatchNorm1d(32), nn.ReLU(), nn.Dropout(0.3),
            nn.Linear(32, output_dim), nn.BatchNorm1d(output_dim), nn.ReLU(),
        )

    def forward(self, x):
        return self.mlp(x)


class LateFusionHeartDiseaseModel(nn.Module):
    def __init__(self, sequence_length=2500, num_classes=2, in_channels=12, demog_dim=8, demo_embed_dim=16):
        super().__init__()
        self.ts_features = nn.Sequential(
            nn.Conv1d(in_channels, 16, kernel_size=7, padding=3), nn.BatchNorm1d(16), nn.ReLU(), nn.Dropout(0.5),
            nn.AdaptiveAvgPool1d(250),
            nn.Conv1d(16, 32, kernel_size=5, padding=2), nn.BatchNorm1d(32), nn.ReLU(), nn.Dropout(0.6),
            nn.AdaptiveAvgPool1d(25),
            nn.Conv1d(32, 32, kernel_size=3, padding=1), nn.BatchNorm1d(32), nn.ReLU(), nn.Dropout(0.8),
            nn.AdaptiveAvgPool1d(1),
        )
        self.demog_features = DemographicMLP(input_dim=demog_dim, output_dim=demo_embed_dim)
        self.classifier = nn.Sequential(nn.Flatten(), nn.Linear(32 + demo_embed_dim, num_classes))

    def forward(self, ts_input, demog_input):
        ts_emb = torch.flatten(self.ts_features(ts_input), start_dim=1)
        demog_emb = self.demog_features(demog_input)
        return self.classifier(torch.cat((ts_emb, demog_emb), dim=1))


class FiLMLayer(nn.Module):
    def __init__(self, demo_embed_dim, num_channels):
        super().__init__()
        self.film_proj = nn.Linear(demo_embed_dim, 2 * num_channels)

    def forward(self, h, demo_embed):
        gamma, beta = self.film_proj(demo_embed).chunk(2, dim=-1)
        return gamma.unsqueeze(-1) * h + beta.unsqueeze(-1)


class HeartDiseaseModel(nn.Module):  # early-fusion (FiLM) CNN
    def __init__(self, sequence_length=2500, num_classes=2, in_channels=12, demog_dim=8, demo_embed_dim=16):
        super().__init__()
        self.demog_features = nn.Sequential(
            nn.Linear(demog_dim, 32), nn.BatchNorm1d(32), nn.ReLU(), nn.Dropout(0.3),
            nn.Linear(32, demo_embed_dim), nn.BatchNorm1d(demo_embed_dim), nn.ReLU(),
        )
        self.conv1 = nn.Conv1d(in_channels, 16, kernel_size=7, padding=3)
        self.bn1 = nn.BatchNorm1d(16)
        self.film1 = FiLMLayer(demo_embed_dim, 16)
        self.act1 = nn.ReLU()
        self.drop1 = nn.Dropout(0.5)
        self.pool1 = nn.AdaptiveAvgPool1d(250)

        self.conv2 = nn.Conv1d(16, 32, kernel_size=5, padding=2)
        self.bn2 = nn.BatchNorm1d(32)
        self.film2 = FiLMLayer(demo_embed_dim, 32)
        self.act2 = nn.ReLU()
        self.drop2 = nn.Dropout(0.6)
        self.pool2 = nn.AdaptiveAvgPool1d(25)

        self.conv3 = nn.Conv1d(32, 32, kernel_size=3, padding=1)
        self.bn3 = nn.BatchNorm1d(32)
        self.film3 = FiLMLayer(demo_embed_dim, 32)
        self.act3 = nn.ReLU()
        self.drop3 = nn.Dropout(0.8)
        self.pool3 = nn.AdaptiveAvgPool1d(1)

        self.classifier = nn.Sequential(nn.Flatten(), nn.Linear(32, num_classes))

    def forward(self, ts_input, demog_input):
        e = self.demog_features(demog_input)
        x = self.pool1(self.drop1(self.act1(self.film1(self.bn1(self.conv1(ts_input)), e))))
        x = self.pool2(self.drop2(self.act2(self.film2(self.bn2(self.conv2(x)), e))))
        x = self.pool3(self.drop3(self.act3(self.film3(self.bn3(self.conv3(x)), e))))
        return self.classifier(x)


# ──────────────────────────────────────────────────────────────────────
# 3. PYRO BAYESIAN ARCHITECTURES (copied from the training scripts)
#    Module/attribute names determine the Pyro parameter names, so they
#    must NOT be renamed or the saved posterior will not load.
# ──────────────────────────────────────────────────────────────────────
class RealSupportMixtureSameFamily(dist.MixtureSameFamily):
    support = constraints.real


class _ScaleMixturePriorMixin:
    def _register_prior_buffers(self):
        self.register_buffer("_prior_probs",
                             torch.tensor([PRIOR["pi"], 1.0 - PRIOR["pi"]], dtype=torch.float32))
        self.register_buffer("_prior_locs", torch.zeros(2, dtype=torch.float32))
        self.register_buffer("_prior_scales",
                             torch.tensor([PRIOR["sigma_1"], PRIOR["sigma_2"]], dtype=torch.float32))

    def _prior(self, shape):
        mixture = RealSupportMixtureSameFamily(
            dist.Categorical(probs=self._prior_probs),
            dist.Normal(self._prior_locs, self._prior_scales),
        )
        return mixture.expand(shape).to_event(len(shape))


class PyroBayesianLinear(_ScaleMixturePriorMixin, PyroModule):
    def __init__(self, in_features, out_features, bias=True):
        super().__init__()
        self._register_prior_buffers()
        self.weight = PyroSample(lambda m: m._prior((out_features, in_features)))
        self.bias = PyroSample(lambda m: m._prior((out_features,))) if bias else None

    def forward(self, x):
        return F.linear(x, self.weight, self.bias)


class PyroBayesianConv1d(_ScaleMixturePriorMixin, PyroModule):
    def __init__(self, in_channels, out_channels, kernel_size, stride=1, padding=0, bias=True):
        super().__init__()
        self.stride, self.padding = stride, padding
        self._register_prior_buffers()
        self.weight = PyroSample(lambda m: m._prior((out_channels, in_channels, kernel_size)))
        self.bias = PyroSample(lambda m: m._prior((out_channels,))) if bias else None

    def forward(self, x):
        return F.conv1d(x, self.weight, self.bias, stride=self.stride, padding=self.padding)


# ---- early-fusion Bayesian (FiLM) ----
class BayesianFiLMLayer(PyroModule):
    def __init__(self, demo_embed_dim, num_channels):
        super().__init__()
        self.film_proj = PyroBayesianLinear(demo_embed_dim, 2 * num_channels)

    def forward(self, h, demo_embed):
        gamma, beta = self.film_proj(demo_embed).chunk(2, dim=-1)
        return gamma.unsqueeze(-1) * h + beta.unsqueeze(-1)


class BayesianFiLMConvBlock(PyroModule):
    def __init__(self, in_channels, out_channels, kernel_size, padding, pool_size,
                 demo_embed_dim, pool_type="avg"):
        super().__init__()
        self.conv = PyroBayesianConv1d(in_channels, out_channels, kernel_size=kernel_size, padding=padding)
        self.bn = nn.BatchNorm1d(out_channels)
        self.film = BayesianFiLMLayer(demo_embed_dim, out_channels)
        self.act = nn.GELU()
        self.pool = nn.AdaptiveAvgPool1d(1) if pool_type == "gap" else nn.AvgPool1d(kernel_size=pool_size)

    def forward(self, x, demo_embed):
        x = self.bn(self.conv(x))
        x = self.act(self.film(x, demo_embed))
        return self.pool(x)


class BayesianHeartDiseaseNet(PyroModule):
    def __init__(self, sequence_length, in_channels, demo_dim, num_classes=2, demo_embed_dim=16):
        super().__init__()
        self.sequence_length = sequence_length
        self.in_channels = in_channels
        self.demo_dim = demo_dim
        self.num_classes = num_classes
        self.demo_embed_dim = demo_embed_dim

        self.demo_linear = PyroBayesianLinear(demo_dim, demo_embed_dim)
        self.demo_activation = nn.GELU()
        self.block1 = BayesianFiLMConvBlock(in_channels, 16, 15, 7, 10, demo_embed_dim, "avg")
        self.block2 = BayesianFiLMConvBlock(16, 32, 9, 4, 10, demo_embed_dim, "avg")
        self.block3 = BayesianFiLMConvBlock(32, 32, 5, 2, None, demo_embed_dim, "gap")
        self.head_linear1 = PyroBayesianLinear(32, 32)
        self.head_activation = nn.GELU()
        self.head_linear2 = PyroBayesianLinear(32, num_classes)

    def forward(self, x_ts, x_demo):
        demo_embed = self.demo_activation(self.demo_linear(x_demo))
        x = self.block1(x_ts, demo_embed)
        x = self.block2(x, demo_embed)
        x = self.block3(x, demo_embed)
        x = torch.flatten(x, start_dim=1)
        x = self.head_activation(self.head_linear1(x))
        return self.head_linear2(x)


class PyroHeartDiseaseClassifier(PyroModule):
    """Wrapper kept so that parameter names ('network.*') match the checkpoint."""
    def __init__(self, network):
        super().__init__()
        self.network = network

    def forward(self, x_ts, x_demo, y=None, dataset_size=None):
        return self.network(x_ts, x_demo)  # no observation site is needed for prediction


# ---- late-fusion Bayesian ----
class BayesianDemographicMLP(PyroModule):
    def __init__(self, input_dim, output_dim=16):
        super().__init__()
        self.fc1 = PyroBayesianLinear(input_dim, 32)
        self.fc2 = PyroBayesianLinear(32, output_dim)
        self.relu = nn.GELU()

    def forward(self, x):
        return self.relu(self.fc2(self.relu(self.fc1(x))))


class BayesianLateFusionHeartDiseaseNet(PyroModule):
    def __init__(self, in_channels=12, demog_dim=8, num_classes=2):
        super().__init__()
        self.conv1 = PyroBayesianConv1d(in_channels, 16, kernel_size=15, padding=7)
        self.pool1 = nn.AvgPool1d(kernel_size=10)
        self.conv2 = PyroBayesianConv1d(16, 32, kernel_size=9, padding=4)
        self.pool2 = nn.AvgPool1d(kernel_size=10)
        self.conv3 = PyroBayesianConv1d(32, 32, kernel_size=5, padding=2)
        self.gap = nn.AdaptiveAvgPool1d(1)
        self.relu = nn.GELU()
        self.demog_features = BayesianDemographicMLP(demog_dim, output_dim=16)
        self.fc_out1 = PyroBayesianLinear(32 + 16, 32)
        self.fc_out2 = PyroBayesianLinear(32, num_classes)

    def forward(self, ts_input, demog_input):
        x = self.pool1(self.relu(self.conv1(ts_input)))
        x = self.pool2(self.relu(self.conv2(x)))
        ts_embedding = torch.flatten(self.gap(self.relu(self.conv3(x))), start_dim=1)
        fused = torch.cat((ts_embedding, self.demog_features(demog_input)), dim=1)
        return self.fc_out2(self.relu(self.fc_out1(fused)))


class PyroLateFusionClassifier(PyroModule):
    def __init__(self, network):
        super().__init__()
        self.network = network

    def forward(self, x_ts, x_demo, y=None, dataset_size=None):
        return self.network(x_ts, x_demo)


def build_mean_field_guide(model):
    return AutoNormal(model, init_scale=float(F.softplus(torch.tensor(POSTERIOR_RHO_INIT))))


# ──────────────────────────────────────────────────────────────────────
# 4. MODEL LOADING
# ──────────────────────────────────────────────────────────────────────
def _torch_load(path, device):
    return torch.load(path, map_location=device, weights_only=False)


def load_pyro_model(path, kind, device, example_ts, example_demo):
    """Rebuild the architecture, then restore BN buffers + variational posterior."""
    ckpt = _torch_load(path, device)
    for key, name in (("sigma_1", "prior_sigma_1"), ("sigma_2", "prior_sigma_2"), ("pi", "prior_pi")):
        if name in ckpt:
            PRIOR[key] = float(ckpt[name])

    in_channels, demo_dim = int(ckpt["in_channels"]), int(ckpt["demo_dim"])
    num_classes = int(ckpt.get("num_classes", 2))
    if kind == "early_bayes":
        net = BayesianHeartDiseaseNet(int(ckpt.get("sequence_length", 2500)), in_channels, demo_dim,
                                      num_classes, int(ckpt.get("demo_embed_dim", 16)))
        model = PyroHeartDiseaseClassifier(net)
    else:
        net = BayesianLateFusionHeartDiseaseNet(in_channels, demo_dim, num_classes)
        model = PyroLateFusionClassifier(net)

    pyro.clear_param_store()  # the param store is global: one Bayesian model at a time
    model = model.to(device)
    result = model.load_state_dict(ckpt["model_state_dict"], strict=False)
    if result.unexpected_keys:
        print(f"    [warn] unexpected keys in model_state_dict: {result.unexpected_keys[:5]}")
    if result.missing_keys:
        print(f"    [warn] missing keys in model_state_dict: {result.missing_keys[:5]}")

    guide = build_mean_field_guide(model).to(device)
    model.eval()
    guide.eval()
    guide(example_ts, example_demo, None, None)  # AutoNormal creates its params lazily
    pyro.get_param_store().set_state(ckpt["pyro_param_store_state"])

    # Sanity check: restored posterior medians must equal those stored at training time.
    if "posterior_median_weights" in ckpt:
        with torch.no_grad():
            med = guide.median(example_ts, example_demo, None, None)
        diffs = [float((med[k].detach().cpu() - v.detach().cpu()).abs().max())
                 for k, v in ckpt["posterior_median_weights"].items() if k in med]
        if not diffs:
            print("    [warn] could not compare posterior medians (no common site names)")
        elif max(diffs) > 1e-5:
            raise RuntimeError(f"Posterior failed to restore correctly (max |diff| = {max(diffs):.3e}). "
                               "Check that the architecture matches the checkpoint.")
        else:
            print(f"    posterior restored OK (max |median diff| = {max(diffs):.1e})")
    return model, guide, extract_prep_from_checkpoint(ckpt)


def load_deterministic_model(path, kind, device):
    obj = _torch_load(path, device)
    if isinstance(obj, nn.Module):  # a fully pickled model
        return obj.to(device).eval(), None, None
    sd = obj["model_state_dict"] if isinstance(obj, dict) and "model_state_dict" in obj else obj
    sd = {k.replace("module.", "", 1): v for k, v in sd.items()}  # DataParallel prefix

    # Infer architecture hyper-parameters from the tensor shapes
    if kind == "late_cnn":
        in_ch = sd["ts_features.0.weight"].shape[1]
        demog_dim = sd["demog_features.mlp.0.weight"].shape[1]
        embed = sd["demog_features.mlp.4.weight"].shape[0]
        model = LateFusionHeartDiseaseModel(2500, 2, in_ch, demog_dim, embed)
    else:
        in_ch = sd["conv1.weight"].shape[1]
        demog_dim = sd["demog_features.0.weight"].shape[1]
        embed = sd["demog_features.4.weight"].shape[0]
        model = HeartDiseaseModel(2500, 2, in_ch, demog_dim, embed)
    print(f"    inferred: in_channels={in_ch}, demog_dim={demog_dim}, demo_embed_dim={embed}")
    model.load_state_dict(sd, strict=True)
    return model.to(device).eval(), extract_prep_from_checkpoint(obj), int(demog_dim)


# ──────────────────────────────────────────────────────────────────────
# 5. INFERENCE
# ──────────────────────────────────────────────────────────────────────
@torch.no_grad()
def predict_deterministic(model, X, demo, batch_size, device):
    out = np.zeros(len(X), dtype=np.float64)
    for s in range(0, len(X), batch_size):
        xb = torch.from_numpy(X[s:s + batch_size]).to(device)
        db = torch.from_numpy(demo[s:s + batch_size]).to(device)
        out[s:s + batch_size] = torch.softmax(model(xb, db), -1)[:, 1].cpu().numpy()
    return out


@torch.no_grad()
def predict_bayesian(model, guide, X, demo, mc_samples, batch_size, device):
    """Return an (S, N) float32 matrix of P(SHD) posterior draws.

    Weights are re-sampled for every (batch, draw) pair. Every COLUMN is therefore a valid
    sample from that ECG's predictive posterior, but a ROW is not one coherent network, so the
    matrix must only be used for per-ECG summaries (mean, 95% interval, share of draws on each
    side of the threshold). That is exactly what find_inconclusive_patients.py computes.
    """
    draws = np.zeros((mc_samples, len(X)), dtype=np.float32)
    n_batches = int(np.ceil(len(X) / batch_size))
    for b, s in enumerate(range(0, len(X), batch_size)):
        xb = torch.from_numpy(X[s:s + batch_size]).to(device)
        db = torch.from_numpy(demo[s:s + batch_size]).to(device)
        for j in range(mc_samples):
            trace = poutine.trace(guide).get_trace(xb, db, None, None)
            logits = poutine.replay(model, trace=trace)(xb, db, None, None)
            draws[j, s:s + len(xb)] = torch.softmax(logits, -1)[:, 1].cpu().numpy()
        print(f"    batch {b + 1}/{n_batches}", end="\r", flush=True)
    print(" " * 40, end="\r")
    return draws


def build_demo_array(demo_dim, prep, knn_k, split_meta, train_meta, data_dir, split):
    """Demographic input whose width matches the trained model.

    * width 7  -> the dataset's own pre-processed EchoNext_<split>_tabular_features.npy
                  (sex, 5 ECG intervals/rates, age; no race one-hot)
    * otherwise-> the metadata pipeline used by the 100K training scripts
                  (6 continuous + one-hot race + one-hot sex = 14 columns)
    """
    if demo_dim == 7:
        path = os.path.join(data_dir, f"EchoNext_{split}_tabular_features.npy")
        if not os.path.exists(path):
            sys.exit(f"Model expects 7 demographic features but {path} was not found.")
        arr = np.load(path).astype(np.float32)
        if arr.shape != (len(split_meta), 7):
            sys.exit(f"{path} has shape {arr.shape}, expected ({len(split_meta)}, 7)")
        print("    demo_dim == 7 -> using the dataset's preprocessed tabular_features.npy")
        return arr
    if prep is None:
        print(f"    no preprocessing objects stored -> refitting imputer/scaler on train split (k={knn_k})")
        prep = fit_demographic_preprocessor(train_meta, knn_k)
    arr = transform_demographics(split_meta, prep)
    if demo_dim is not None and arr.shape[1] != demo_dim:
        sys.exit(f"Model expects {demo_dim} demographic features but the metadata pipeline produced "
                 f"{arr.shape[1]}. The checkpoint was trained with a different demographic encoding.")
    return arr


